# Environment Configuration
# Copy this file to .env and adjust values as needed.

# Server
HOST=127.0.0.1
PORT=8080
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=30s
HEALTH_CACHE_DURATION=30s

# Request body size limits (4 MiB and 100 MiB)
MAX_BODY_BYTES=4194304
MAX_FILE_BODY_BYTES=104857600

# TLS (optional)
TLS_CERT_PATH=./cert.pem
TLS_KEY_PATH=./key.pem

# Authentication
# Generate keys with: make generate-keys
AUTH_PUBLIC_PEM_FILEPATH=./public.pem
AUTH_PRIVATE_PEM_FILEPATH=./private.pem

# Encryption
ENCRYPTION_KEY_FILEPATH=./encryption.key

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.nvisy.com
CORS_MAX_AGE=1h
CORS_ALLOW_CREDENTIALS=true

# OpenAPI
OPENAPI_JSON_PATH=/api/openapi.json
OPENAPI_SCALAR_PATH=/api/scalar

# PostgreSQL
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/postgres
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_CONNECTION_TIMEOUT=10s
POSTGRES_IDLE_TIMEOUT=10m

# NATS
NATS_URL=nats://localhost:4222
NATS_TOKEN=
NATS_CLIENT_NAME=nvisy-server
NATS_CONNECT_TIMEOUT=30s
NATS_REQUEST_TIMEOUT=30s
NATS_MAX_RECONNECTS=10

# S3-compatible blob store
# Local dev uses RustFS (docker-compose.dev.yml); the bucket must exist.
S3_BUCKET=nvisy-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin

# Pipeline
PIPELINE_MAX_CONCURRENT_JOBS=10

# Engine
# Path to the deployment engine config (NER/LLM lineups, server-wide enrichment,
# deduplication calibration). Unset means pattern recognizers only, no enrichment.
ENGINE_CONFIG_FILEPATH=

# Logging
RUST_LOG=info,nvisy_cli=debug,nvisy_server=debug,nvisy_postgres=debug,nvisy_nats=debug,nvisy_webhook=debug
RUST_BACKTRACE=0
