# Environment Configuration
# Copy this file to .env and adjust values as needed.

# Server
HOST=127.0.0.1
PORT=8080
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=30s
HEALTH_CACHE_DURATION=30s

# Request body size limits (4 MiB ordinary requests, 500 MiB file uploads)
MAX_BODY_BYTES=4194304
MAX_FILE_BODY_BYTES=524288000

# TLS (optional)
TLS_CERT_PATH=./cert.pem
TLS_KEY_PATH=./key.pem

# Authentication
# Generate keys with: make generate-keys
AUTH_PUBLIC_PEM_FILEPATH=./public.pem
AUTH_PRIVATE_PEM_FILEPATH=./private.pem

# Encryption
ENCRYPTION_KEY_FILEPATH=./encryption.key

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.nvisy.com
CORS_MAX_AGE=1h
CORS_ALLOW_CREDENTIALS=true

# OpenAPI
OPENAPI_JSON_PATH=/api/openapi.json
OPENAPI_SCALAR_PATH=/api/scalar

# PostgreSQL
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/postgres
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_CONNECTION_TIMEOUT=10s
POSTGRES_IDLE_TIMEOUT=10m

# NATS
NATS_URL=nats://localhost:4222
NATS_TOKEN=
NATS_CLIENT_NAME=nvisy-server
NATS_CONNECT_TIMEOUT=30s
NATS_REQUEST_TIMEOUT=30s
NATS_MAX_RECONNECTS=10

# S3-compatible blob store
# Local dev uses RustFS (docker-compose.dev.yml); the bucket must exist.
S3_BUCKET=nvisy-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin

# Engine
# ENGINE_CONFIG_FILEPATH=

# Connection sync
SYNC_IMPORT_CONCURRENCY=4

# Connections
# How caller-supplied connection endpoints are validated.
# `permissive` (self-hosted): https anywhere, plaintext http only for loopback emulators or
# `strict` (cloud): https only, resolving to globally routable addresses only.
CONNECTION_ENDPOINT_POLICY=permissive

# Cloud file-service connectors (OAuth)
# Frontend page the OAuth callback sends the browser to when the flow finishes.
# A `{workspaceSlug}` placeholder is substituted with the workspace's slug, and a
# `?connection=success|error` query is appended. Point this at a frontend page,
# never at the callback route. Blank falls back to a minimal in-page result.
# Example: http://localhost:3000/w/{workspaceSlug}/integrations
FILE_SERVICE_POST_AUTH_REDIRECT_URI=http://localhost:3000/w/{workspaceSlug}/integrations

# Google Drive
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=

# Dropbox
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=

# Microsoft OneDrive
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=

# Box
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REDIRECT_URI=

# OIDC sign-in (Google, Microsoft)
# Each provider is enabled only when its client id, secret, and redirect URI are
# all set. The redirect URI is the sign-in callback route registered with the
# provider (e.g. http://localhost:8080/auth/google/callback/). The issuer is the
# OIDC issuer used for discovery; leave blank to use the provider default.
#
# Frontend origins the sign-in callback may redirect the browser back to, as a
# comma-separated list of scheme://host[:port]. A caller-supplied redirect must
# match one of these or it is refused — this stops the flow (which carries the
# minted session token) from being pointed at an attacker's host. Empty means no
# external redirect is allowed (the callback shows a minimal in-page result).
OIDC_ALLOWED_REDIRECT_ORIGINS=http://localhost:3000

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Default: https://accounts.google.com
GOOGLE_ISSUER=

# Microsoft (Entra). SECURITY: the default issuer is the multi-tenant `common`
# endpoint, which admits ANY Microsoft work, school, or personal account — not
# just your organization's. Its `sub` claim is also unique only per tenant. A
# single-organization deployment should pin its tenant by setting the issuer to
# https://login.microsoftonline.com/{tenant-id}/v2.0 so only that tenant's users
# can sign in and issuer validation is strict. Leave `common` only if you truly
# intend to accept any Microsoft identity.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
# Default: https://login.microsoftonline.com/common/v2.0
MICROSOFT_ISSUER=

# Webhook HTTP client
HTTP_TIMEOUT=30s
HTTP_MAX_RETRIES=1
HTTP_MIN_RETRY_INTERVAL=500ms
HTTP_MAX_RETRY_INTERVAL=30s
HTTP_USER_AGENT=

# Logging
RUST_LOG=info,nvisy_cli=debug,nvisy_server=debug,nvisy_postgres=debug,nvisy_nats=debug,nvisy_webhook=debug
RUST_BACKTRACE=0
