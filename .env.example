# Environment Configuration
# Run `make generate-env` to create or update your .env from this file
# (adds new keys, keeps your existing values), then adjust as needed.

# ─── Server ───

# Host address to bind the server to
HOST=127.0.0.1

# TCP port number for the server to listen on
PORT=8080

# Maximum time to wait for graceful shutdown (e.g. 30s, 2m)
SHUTDOWN_TIMEOUT=30s

# Path to TLS certificate file (PEM format)
# TLS_CERT_PATH=

# Path to TLS private key file (PEM format)
# TLS_KEY_PATH=

# ─── CORS ───

# List of allowed CORS origins (comma-separated)
# CORS_ORIGINS=

# Maximum age for CORS preflight caching (e.g. 1h)
CORS_MAX_AGE=1h

# Whether to allow credentials in CORS requests
CORS_ALLOW_CREDENTIALS=true

# ─── OpenAPI ───

# Path which exposes the OpenAPI JSON specification
OPENAPI_JSON_PATH=/api/openapi.json

# Path which exposes the Scalar API reference UI
OPENAPI_SCALAR_PATH=/api/scalar

# ─── Recovery ───

# Maximum duration to wait for a request to complete before timing out (e.g. 30s).
# Requests exceeding this duration receive a 500 response with a timeout message
REQUEST_TIMEOUT=30s

# ─── Client IP source ───

# Where the caller's IP is read from for security and audit records
CLIENT_IP_SOURCE=ConnectInfo

# ─── PostgreSQL ───

# PostgreSQL connection URL
# POSTGRES_URL=

# Maximum number of connections in the pool (2-16)
POSTGRES_MAX_CONNECTIONS=10

# Maximum time to wait for a connection from the pool before failing
POSTGRES_CONNECTION_TIMEOUT=10s

# Idle connection timeout (optional)
# POSTGRES_IDLE_TIMEOUT=

# ─── NATS ───

# NATS server URL (comma-separated for clustering)
# NATS_URL=

# Authentication token
# NATS_TOKEN=

# Client connection name for debugging and monitoring
# NATS_CLIENT_NAME=

# Connection timeout (optional)
# NATS_CONNECT_TIMEOUT=

# Request timeout (optional)
# NATS_REQUEST_TIMEOUT=

# Maximum number of reconnection attempts (0 = unlimited)
# NATS_MAX_RECONNECTS=

# ─── S3-compatible blob store ───

# Name of the S3 bucket holding all first-party objects
# S3_BUCKET=

# AWS region. Also required by S3-compatible servers, which usually accept any value
S3_REGION=us-east-1

# Endpoint URL of an S3-compatible server (e.g. http://localhost:9000). Unset targets AWS
# S3 itself
# S3_ENDPOINT=

# Use path-style addressing (endpoint/bucket/key) rather than virtual-host style
# (bucket.endpoint/key). Required by most S3-compatible servers; AWS S3 uses virtual-host
# style
S3_FORCE_PATH_STYLE=true

# Access key id. When unset (alongside secret_access_key), the SDK's default credential
# chain is used (environment, profile, IAM role, …)
# S3_ACCESS_KEY_ID=

# Secret access key, paired with access_key_id for static credentials
# S3_SECRET_ACCESS_KEY=

# ─── Authentication ───

# File path to the JWT decoding (public) key used for sessions
AUTH_PUBLIC_PEM_FILEPATH=./public.pem

# File path to the JWT encoding (private) key used for sessions
AUTH_PRIVATE_PEM_FILEPATH=./private.pem

# ─── Encryption ───

# File path to the 32-byte master encryption key
ENCRYPTION_KEY_FILEPATH=./encryption.key

# ─── Engine ───

# Optional path to a TOML file with the deployment engine configuration
# ENGINE_CONFIG_FILEPATH=

# ─── Health ───

# How long cached health results remain valid before a fresh check
HEALTH_CACHE_DURATION=30s

# ─── Connections ───

# How caller-supplied connection endpoints are validated
CONNECTION_ENDPOINT_POLICY=permissive

# Maximum objects imported (provider → Nvisy) concurrently within a single sync. Bounds
# the in-flight fetch/decrypt/store pipelines against one connection
CONNECTION_SYNC_IMPORT_CONCURRENCY=4

# Maximum files exported (Nvisy → provider) concurrently within a single sync. Bounds
# the in-flight read/decrypt/upload pipelines against one connection
CONNECTION_SYNC_EXPORT_CONCURRENCY=4

# ─── Cloud file-service connectors (OAuth) ───

# The OAuth callback URI, shared by every provider
# FILE_SERVICE_OAUTH_REDIRECT_URI=

# Google Drive OAuth app client id. Set with the client secret to enable the connector.
# GOOGLE_DRIVE_CLIENT_ID=

# Google Drive OAuth app client secret.
# GOOGLE_DRIVE_CLIENT_SECRET=

# Dropbox OAuth app client id. Set with the client secret to enable the connector.
# DROPBOX_CLIENT_ID=

# Dropbox OAuth app client secret.
# DROPBOX_CLIENT_SECRET=

# OneDrive OAuth app client id. Set with the client secret to enable the connector.
# ONEDRIVE_CLIENT_ID=

# OneDrive OAuth app client secret.
# ONEDRIVE_CLIENT_SECRET=

# Box OAuth app client id. Set with the client secret to enable the connector.
# BOX_CLIENT_ID=

# Box OAuth app client secret.
# BOX_CLIENT_SECRET=

# Frontend URL the OAuth callback redirects the user's browser to once the flow finishes.
# The callback appends a ?connection=success or ?connection=error query. Unset (or blank)
# falls back to a minimal in-page result. Point this at a frontend page, never at the
# callback route itself
# FILE_SERVICE_POST_AUTH_REDIRECT_URI=

# ─── OIDC sign-in ───

# Google sign-in OIDC client id. Set with the client secret and redirect URI to enable
# sign-in.
# GOOGLE_CLIENT_ID=

# Google sign-in OIDC client secret.
# GOOGLE_CLIENT_SECRET=

# Google sign-in callback URI, registered with the provider (the route the callback is
# served at).
# GOOGLE_REDIRECT_URI=

# Google OIDC issuer URL, used for discovery. Falls back to the provider default when
# unset; one without a default must set it explicitly.
# GOOGLE_ISSUER=

# Microsoft (Entra) sign-in OIDC client id. Set with the client secret and redirect URI to
# enable sign-in.
# MICROSOFT_CLIENT_ID=

# Microsoft (Entra) sign-in OIDC client secret.
# MICROSOFT_CLIENT_SECRET=

# Microsoft (Entra) sign-in callback URI, registered with the provider (the route the
# callback is served at).
# MICROSOFT_REDIRECT_URI=

# Microsoft (Entra) OIDC issuer URL, used for discovery. Falls back to the provider
# default when unset; one without a default must set it explicitly.
# MICROSOFT_ISSUER=

# Allowed frontend origins the sign-in callback may redirect to, as a comma-separated list
# of scheme://host:port origins
# OIDC_ALLOWED_REDIRECT_ORIGINS=

# Allowed custom URL schemes the sign-in callback may deep-link to for native (desktop)
# app auth, as a comma-separated list of bare scheme names (e.g. nvisy)
# DESKTOP_ALLOWED_REDIRECT_SCHEMES=

# ─── Request body size limits ───

# Maximum size in bytes for an ordinary request body (non-upload routes)
MAX_BODY_BYTES=4194304

# Maximum size in bytes for a file upload request body
MAX_FILE_BODY_BYTES=524288000

# ─── Session cookies ───

# Whether session cookies carry the Secure attribute (HTTPS-only)
COOKIE_SECURE=true

# ─── Webhook HTTP client ───

# HTTP request timeout (e.g. 30s); falls back to the default when unset
# HTTP_TIMEOUT=

# User-Agent header to send with requests
# HTTP_USER_AGENT=

# Maximum number of retry attempts for transient failures
HTTP_MAX_RETRIES=1

# Minimum retry interval (e.g. 500ms)
HTTP_MIN_RETRY_INTERVAL=500ms

# Maximum retry interval (e.g. 30s)
HTTP_MAX_RETRY_INTERVAL=30s

# ─── Logging ───

# Tracing filter: comma-separated target=level directives.
RUST_LOG=info,nvisy_cli=debug,nvisy_server=debug,nvisy_postgres=debug,nvisy_nats=debug,nvisy_webhook=debug

# Panic backtraces: 0 off, 1 on, full for full (verbose) traces.
RUST_BACKTRACE=0
